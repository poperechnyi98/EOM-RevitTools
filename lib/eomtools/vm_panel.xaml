<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
      TextElement.Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}">
  <Grid.Resources>
    <!-- Обычные кнопки панели: плоские, скруглённые, с подсветкой -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="#F4F6F8"/>
      <Setter Property="BorderBrush" Value="#C3CBD3"/>
      <Setter Property="Foreground" Value="#263238"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E3EBF2"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#7E97AB"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#D2DEE8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Плитка-переключатель: цвет фона задаётся из кода по состоянию -->
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <TabControl x:Name="tabs" Grid.Row="0" Margin="4,6,4,0">
    <TabItem Header="Рабочие наборы">
      <DockPanel Margin="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,2,0,6" LastChildFill="True">
          <Button x:Name="all_on_button" DockPanel.Dock="Left" Content="All On" Margin="0,0,4,0"/>
          <Button x:Name="all_off_button" DockPanel.Dock="Left" Content="All Off" Margin="0,0,8,0"/>
          <TextBox x:Name="search_box" VerticalContentAlignment="Center"
                   ToolTip="Поиск рабочего набора по имени"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="content_panel" Margin="0,0,2,0">
            <DockPanel Margin="0,0,0,2">
              <Button x:Name="groups_button" DockPanel.Dock="Right" Padding="6,2"
                      ToolTip="Настройка: группы и наименование рабочих наборов">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14"/>
              </Button>
              <TextBlock Text="Группы" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <WrapPanel x:Name="groups_panel" Margin="0,0,0,8"/>
            <StackPanel x:Name="worksets_panel"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </TabItem>
    <TabItem Header="Категории">
      <DockPanel Margin="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,2,0,6" LastChildFill="False">
          <Button x:Name="cat_all_on_button" DockPanel.Dock="Left" Content="All On" Margin="0,0,4,0"
                  ToolTip="Показать все быстрые категории"/>
          <Button x:Name="cat_all_off_button" DockPanel.Dock="Left" Content="All Off"
                  ToolTip="Скрыть все быстрые категории"/>
          <Button x:Name="cat_setup_button" DockPanel.Dock="Right" Padding="6,2"
                  ToolTip="Настройка: быстрые категории элементов и аннотаций">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14"/>
          </Button>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="cat_content_panel" Margin="0,0,2,0">
            <Expander x:Name="model_expander" IsExpanded="True" Margin="0,0,0,6">
              <Expander.Header>
                <TextBlock x:Name="model_header" FontWeight="Bold" Text="Элементы"/>
              </Expander.Header>
              <WrapPanel x:Name="model_panel" Margin="0,2,0,0"/>
            </Expander>
            <Expander x:Name="annotation_expander" IsExpanded="True">
              <Expander.Header>
                <TextBlock x:Name="annotation_header" FontWeight="Bold" Text="Аннотации"/>
              </Expander.Header>
              <WrapPanel x:Name="annotation_panel" Margin="0,2,0,0"/>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </TabItem>
    <TabItem Header="Цвета">
      <DockPanel Margin="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,2,0,6" LastChildFill="False">
          <Button x:Name="colors_apply_button" DockPanel.Dock="Left" Content="Применить" Margin="0,0,4,0"
                  ToolTip="Создать недостающие и обновить существующие фильтры 3_ВСЕ_РБ_… по схеме (другие фильтры не трогает)"/>
          <Button x:Name="colors_clear_button" DockPanel.Dock="Left" Content="Снять"
                  ToolTip="Убрать с вида (или шаблона) все фильтры 3_ВСЕ_РБ_…"/>
          <Button x:Name="colors_take_button" DockPanel.Dock="Left" Content="Взять из вида" Margin="4,0,0,0"
                  ToolTip="Записать цвета и прозрачность фильтров 3_ВСЕ_РБ_… этого вида в вашу схему"/>
          <Button x:Name="colors_setup_button" DockPanel.Dock="Right" Padding="6,2"
                  ToolTip="Настройка: цвета и прозрачность по рабочим наборам">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14"/>
          </Button>
        </DockPanel>
        <TextBlock x:Name="colors_state_label" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray"
                   FontSize="11" Margin="0,0,0,6"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="colors_panel" Margin="0,0,2,0"/>
        </ScrollViewer>
      </DockPanel>
    </TabItem>
    <TabItem Header="Шаблоны">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
          <DockPanel Margin="0,2,0,6">
            <Button x:Name="tpl_folder_button" DockPanel.Dock="Right" Content="Папка…" Margin="4,0,0,0"
                    ToolTip="Выбрать папку, где хранятся ваши шаблоны вида"/>
            <TextBlock x:Name="tpl_folder_label" TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                       VerticalAlignment="Center"/>
          </DockPanel>

          <TextBlock Text="В модели" FontWeight="Bold" Margin="0,2,0,2"/>
          <TextBox x:Name="tpl_search_box" Margin="0,0,0,4" ToolTip="Поиск шаблона"/>
          <ListBox x:Name="tpl_model_list" SelectionMode="Extended" Height="190"/>
          <WrapPanel Margin="0,4,0,8">
            <Button x:Name="tpl_export_button" Content="Экспорт выбранных" Margin="0,0,4,4"
                    ToolTip="Сохранить выбранные шаблоны в папку (каждый — отдельный файл .rvt)"/>
            <Button x:Name="tpl_export_current_button" Content="Экспорт шаблона этого вида" Margin="0,0,0,4"/>
          </WrapPanel>

          <TextBlock Text="В папке" FontWeight="Bold" Margin="0,2,0,2"/>
          <ListBox x:Name="tpl_library_list" SelectionMode="Extended" Height="190"/>
          <WrapPanel Margin="0,4,0,0">
            <Button x:Name="tpl_import_button" Content="Импорт выбранных" Margin="0,0,4,4"
                    ToolTip="Скопировать выбранные шаблоны из папки в эту модель"/>
            <Button x:Name="tpl_open_button" Content="Открыть папку" Margin="0,0,4,4"/>
            <Button x:Name="tpl_rescan_button" Content="Обновить список" Margin="0,0,0,4"/>
          </WrapPanel>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,4,0,0"
                     Text="Шаблон хранится как маленький файл .rvt с именем шаблона — вместе с его фильтрами, типами линий и штриховками. Если в модели уже есть шаблон с таким именем, при импорте плагин спросит: заменить (виды переключатся на новый) или добавить копией."/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>

  <Border Grid.Row="1" BorderBrush="#D5DBE1" BorderThickness="0,1,0,0" Margin="4,6,4,0">
    <StackPanel Margin="4,6,4,8">
      <WrapPanel x:Name="legend_panel" Margin="0,0,0,6"/>
      <CheckBox x:Name="allow_template_box" Margin="0,0,0,6"
                ToolTip="Если шаблон вида управляет видимостью, изменения будут вноситься в шаблон — они коснутся всех видов с этим шаблоном.">
        <TextBlock Text="Разрешаю менять шаблон вида" TextWrapping="Wrap"/>
      </CheckBox>
      <WrapPanel>
        <Button x:Name="save_button" Content="Сохранить профиль" Margin="0,0,4,4"
                ToolTip="Сохранить группы и быстрые категории в файл"/>
        <Button x:Name="load_button" Content="Загрузить профиль" Margin="0,0,0,4"
                ToolTip="Загрузить группы и быстрые категории из файла"/>
      </WrapPanel>
      <TextBlock x:Name="status_label" TextWrapping="Wrap" FontSize="11" Foreground="#37474F"
                 Margin="0,2,0,0" LineHeight="15"/>
      <Border BorderBrush="#E1E5EA" BorderThickness="0,1,0,0" Margin="0,8,0,6"/>
      <TextBlock x:Name="view_label" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"
                 LineHeight="15" Foreground="#37474F"/>
      <TextBlock x:Name="target_label" FontSize="11" TextWrapping="Wrap" LineHeight="15"
                 Margin="0,4,0,0"/>
    </StackPanel>
  </Border>
</Grid>
