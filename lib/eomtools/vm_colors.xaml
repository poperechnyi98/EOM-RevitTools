<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Manager — цвета по рабочим наборам" Width="920" Height="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
  <DockPanel Margin="10">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Параметр для различения общих РБ:" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="param_box" Width="180" VerticalContentAlignment="Center"
                 ToolTip="У наших элементов он заполнен, у элементов смежников — пуст. Нужен только для РБ, которые есть и у нас, и в связях."/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="ok_button" Content="OK" Width="90" Padding="0,3" Margin="0,0,6,0" IsDefault="True"/>
        <Button x:Name="cancel_button" Content="Отмена" Width="90" Padding="0,3" IsCancel="True"/>
      </StackPanel>
    </DockPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Модели" FontWeight="Bold" Margin="0,0,0,4"/>
        <ListBox x:Name="sources_list"/>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="source_title" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="source_hint" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,6"/>
          <DockPanel Margin="0,0,0,6">
            <Button x:Name="all_on_button" DockPanel.Dock="Right" Content="Красить найденные" Padding="6,2" Margin="4,0,0,0"/>
            <Button x:Name="all_off_button" DockPanel.Dock="Right" Content="Не красить найденные" Padding="6,2" Margin="4,0,0,0"/>
            <TextBox x:Name="search_box" VerticalContentAlignment="Center" ToolTip="Поиск рабочего набора"/>
          </DockPanel>
          <Grid Margin="4,0,22,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Рабочий набор" Foreground="Gray"/>
            <TextBlock Grid.Column="1" Text="Цвет" Foreground="Gray"/>
            <TextBlock Grid.Column="2" Text="Прозрачность" Foreground="Gray"/>
          </Grid>
        </StackPanel>
        <Border BorderBrush="Gray" BorderThickness="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="rows_panel" Margin="4"/>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
