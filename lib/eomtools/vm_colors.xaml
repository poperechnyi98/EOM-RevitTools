<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Manager — цвета по рабочим наборам" Width="960" Height="700" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F3F5F7" Foreground="#263238">
  <Window.Resources>__VM_STYLE__</Window.Resources>
  <DockPanel>
    <!-- подвал -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D5DBE1" BorderThickness="0,1,0,0"
            Padding="16,10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ok_button" Content="Сохранить" Style="{StaticResource Primary}" MinWidth="100"
                  Margin="0,0,8,0" IsDefault="True"/>
          <Button x:Name="cancel_button" Content="Отмена" MinWidth="90" IsCancel="True"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Одинаковые РБ у нас и в связях различать по параметру:"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="param_box" Width="160"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                     Text="У наших элементов параметр заполнен, у элементов связей — пуст. Нужен только для РБ, которые есть и у нас, и в связях (помечены оранжевым)."/>
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- шапка -->
    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,10">
      <TextBlock Text="Цвета по рабочим наборам" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                 Text="Отметьте РБ, которые нужно красить, выберите цвет и прозрачность. На вид схема попадёт по кнопке «Применить» на панели."/>
    </StackPanel>
    <Grid Margin="16,0,16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Модели" Style="{StaticResource H2}" Margin="0,0,0,6"/>
          <ListBox x:Name="sources_list"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="source_title" Style="{StaticResource H2}" TextWrapping="Wrap"/>
            <TextBlock x:Name="source_hint" Style="{StaticResource Hint}" Margin="0,2,0,8"/>
            <CheckBox x:Name="show_all_box" Margin="0,0,0,8">
              <TextBlock Text="Показать все РБ (по умолчанию только с префиксом 2_)"/>
            </CheckBox>
            <DockPanel Margin="0,0,0,8">
              <Button x:Name="all_on_button" DockPanel.Dock="Right" Content="Красить найденные" Margin="6,0,0,0"/>
              <Button x:Name="all_off_button" DockPanel.Dock="Right" Content="Не красить найденные" Margin="6,0,0,0"/>
              <TextBox x:Name="search_box" ToolTip="Поиск рабочего набора"/>
            </DockPanel>
            <Grid Margin="4,0,22,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="170"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Рабочий набор" Style="{StaticResource Hint}"/>
              <TextBlock Grid.Column="1" Text="Цвет" Style="{StaticResource Hint}"/>
              <TextBlock Grid.Column="2" Text="Прозрачность" Style="{StaticResource Hint}"/>
            </Grid>
            <Border BorderBrush="#E1E5EA" BorderThickness="0,1,0,0"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="rows_panel" Margin="4,4,4,0"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
