<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Manager — быстрые категории" Width="560" Height="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="ok_button" Content="OK" Width="90" Padding="0,3" Margin="0,0,6,0" IsDefault="True"/>
      <Button x:Name="cancel_button" Content="Отмена" Width="90" Padding="0,3" IsCancel="True"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="Gray"
               Text="Отметьте категории, которые нужны под рукой. Они появятся плитками на вкладке «Категории»."/>
    <TabControl x:Name="tabs"/>
  </DockPanel>
</Window>
