<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Manager — быстрые категории" Width="600" Height="680" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F3F5F7" Foreground="#263238">
  <Window.Resources>__VM_STYLE__</Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D5DBE1" BorderThickness="0,1,0,0"
            Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ok_button" Content="Сохранить" Style="{StaticResource Primary}" MinWidth="100"
                Margin="0,0,8,0" IsDefault="True"/>
        <Button x:Name="cancel_button" Content="Отмена" MinWidth="90" IsCancel="True"/>
      </StackPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,0">
      <TextBlock Text="Быстрые категории" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                 Text="Отметьте категории, которые нужны под рукой, — они появятся плитками на вкладке «Категории»."/>
    </StackPanel>
    <TabControl x:Name="tabs" Margin="16,8,16,12"/>
  </DockPanel>
</Window>
