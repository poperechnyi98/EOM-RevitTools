<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Manager — настройка рабочих наборов" Width="780" Height="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="ok_button" Content="OK" Width="90" Padding="0,3" Margin="0,0,6,0" IsDefault="True"/>
      <Button x:Name="cancel_button" Content="Отмена" Width="90" Padding="0,3" IsCancel="True"/>
    </StackPanel>
    <TabControl x:Name="tabs">

      <TabItem Header="Группы">
        <Grid Margin="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Группы" FontWeight="Bold" Margin="0,0,0,4"/>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
              <Button x:Name="add_button" Content="Добавить" Padding="8,3" Margin="0,0,4,4"/>
              <Button x:Name="delete_button" Content="Удалить" Padding="8,3" Margin="0,0,4,4"/>
              <Button x:Name="up_button" Content="↑" Padding="10,3" Margin="0,0,4,4" ToolTip="Выше"/>
              <Button x:Name="down_button" Content="↓" Padding="10,3" Margin="0,0,0,4" ToolTip="Ниже"/>
            </WrapPanel>
            <ListBox x:Name="groups_list"/>
          </DockPanel>
          <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Название группы" FontWeight="Bold"/>
              <TextBox x:Name="name_box" Margin="0,3,0,8"/>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Рабочие наборы группы" FontWeight="Bold"/>
                <TextBlock x:Name="count_label" Margin="8,0,0,0" Foreground="Gray"/>
              </DockPanel>
              <TextBox x:Name="search_box" Margin="0,3,0,4" ToolTip="Поиск по имени рабочего набора"/>
              <WrapPanel Margin="0,0,0,4">
                <Button x:Name="check_shown_button" Content="Отметить найденные" Padding="6,2" Margin="0,0,4,0"/>
                <Button x:Name="uncheck_shown_button" Content="Снять с найденных" Padding="6,2"/>
              </WrapPanel>
            </StackPanel>
            <Border BorderBrush="Gray" BorderThickness="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="worksets_panel" Margin="4"/>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Наименование РБ">
        <Grid Margin="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                         Text="Сокращает имена рабочих наборов только на плитках панели. В модели ничего не переименовывается, полное имя видно в подсказке."/>
              <CheckBox x:Name="strip_prefix_box" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap"
                           Text="Убирать номер в начале (0_, 1_, 2_ …) — он виден в заголовке подгруппы"/>
              </CheckBox>
              <TextBlock Text="Правила: найти → заменить на" FontWeight="Bold"/>
              <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,6"
                         Text="Применяются сверху вниз. Пустое «заменить на» — просто убрать текст. Учитываются пробелы и регистр."/>
              <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="18"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Найти" Foreground="Gray"/>
                <TextBlock Grid.Column="2" Text="Заменить на" Foreground="Gray"/>
              </Grid>
            </StackPanel>
            <Button x:Name="add_rule_button" DockPanel.Dock="Bottom" Content="Добавить правило"
                    HorizontalAlignment="Left" Padding="8,3" Margin="0,6,0,0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="rules_panel"/>
            </ScrollViewer>
          </DockPanel>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Как будет на плитках" FontWeight="Bold" Margin="0,0,0,4"/>
            <Border BorderBrush="Gray" BorderThickness="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="preview_panel" Margin="4"/>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
