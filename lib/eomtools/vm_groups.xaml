<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Manager — настройка рабочих наборов" Width="1040" Height="700"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F3F5F7" Foreground="#263238">
  <Window.Resources>__VM_STYLE__</Window.Resources>
  <DockPanel>
    <!-- подвал -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D5DBE1" BorderThickness="0,1,0,0"
            Padding="16,10">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ok_button" Content="Сохранить" Style="{StaticResource Primary}" MinWidth="100"
                  Margin="0,0,8,0" IsDefault="True"/>
          <Button x:Name="cancel_button" Content="Отмена" MinWidth="90" IsCancel="True"/>
        </StackPanel>
        <TextBlock x:Name="footer_hint" DockPanel.Dock="Left" Style="{StaticResource Hint}"
                   VerticalAlignment="Center" MaxWidth="640"/>
      </DockPanel>
    </Border>
    <!-- шапка -->
    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,0">
      <TextBlock Text="Рабочие наборы" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                 Text="Группы — кнопки быстрого включения наверху панели. Подгруппы — разделы, на которые делится список РБ. Наименование — как сокращать имена на плитках."/>
    </StackPanel>
    <TabControl x:Name="tabs" Margin="16,8,16,12">
      <TabItem x:Name="groups_tab" Header="Группы"/>
      <TabItem x:Name="sections_tab" Header="Подгруппы"/>
      <TabItem Header="Наименование РБ">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Правила: найти → заменить на" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8"
                           Text="Применяются сверху вниз. Пустое «заменить на» — просто убрать текст. Учитываются пробелы и регистр. Меняется только подпись на плитке."/>
                <Grid Margin="0,0,0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Найти" Style="{StaticResource Hint}"/>
                  <TextBlock Grid.Column="2" Text="Заменить на" Style="{StaticResource Hint}"/>
                </Grid>
              </StackPanel>
              <Button x:Name="add_rule_button" DockPanel.Dock="Bottom" Content="+  Добавить правило"
                      HorizontalAlignment="Left" Margin="0,8,0,0"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="rules_panel"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Как будет на плитках" Style="{StaticResource H2}"
                         Margin="0,0,0,6"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="preview_panel"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
