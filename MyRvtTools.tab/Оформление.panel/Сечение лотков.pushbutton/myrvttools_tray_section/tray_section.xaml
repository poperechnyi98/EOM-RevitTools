<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyRvtTools — Сечение лотков" Width="640" Height="450" MinWidth="500" MinHeight="370"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        __VM_STYLE__
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,9">
      <StackPanel>
        <TextBlock Text="Сечение лотков" Style="{StaticResource H1}"/>
        <TextBlock x:Name="section_view" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Файл Excel" Style="{StaticResource H2}" Margin="0,0,0,4"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
          <Button x:Name="browse" DockPanel.Dock="Right" Content="Обзор…" Margin="8,0,0,0" MinWidth="92"/>
          <TextBox x:Name="file_path" IsReadOnly="True" MinHeight="28"
                   Padding="7,3" VerticalContentAlignment="Center"
                   AutomationProperties.Name="Путь к файлу Excel"/>
        </DockPanel>
        <TextBlock Grid.Row="2" Text="Расчётный лист" Style="{StaticResource H2}" Margin="0,0,0,4"/>
        <ComboBox x:Name="sheets" Grid.Row="3" MinHeight="28" MaxDropDownHeight="280"
                  IsEnabled="False" AutomationProperties.Name="Расчётный лист"/>
        <CheckBox x:Name="use_group_names" Grid.Row="4" Content="Номера групп заполнены"
                  IsChecked="False" Margin="0,10,0,0" Foreground="{DynamicResource Ink}"
                  ToolTip="Подставить номера групп из столбца K «Название КЛ»."/>
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock x:Name="summary" TextWrapping="Wrap"/>
            <TextBlock x:Name="status" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="Выберите книгу Excel с расчётом наполнения лотка."/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="build" Content="Построить" Style="{StaticResource Primary}"
              MinWidth="108" IsDefault="True" IsEnabled="False" Margin="0,0,8,0"/>
      <Button Content="Отмена" MinWidth="88" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
