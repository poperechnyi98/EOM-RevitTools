<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Типы оформления" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        __VM_STYLE__
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <StackPanel Margin="14">
    <Border Style="{StaticResource Card}" Padding="12">
      <StackPanel>
        <TextBlock Text="Тексты на разрезе" Style="{StaticResource H2}" Margin="0,0,0,4"/>
        <ComboBox x:Name="text_types" MinHeight="28" MaxDropDownHeight="260"
                  AutomationProperties.Name="Тексты на разрезе"/>
        <TextBlock Text="Цветовая область лотка" Style="{StaticResource H2}" Margin="0,12,0,4"/>
        <ComboBox x:Name="region_types" MinHeight="28" MaxDropDownHeight="260"
                  AutomationProperties.Name="Цветовая область лотка"/>
        <TextBlock x:Name="message" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="save" Content="Сохранить" IsDefault="True" IsEnabled="False"
              Style="{StaticResource Primary}" MinWidth="104" Margin="0,0,8,0"/>
      <Button Content="Отмена" IsCancel="True" MinWidth="88"/>
    </StackPanel>
  </StackPanel>
</Window>
