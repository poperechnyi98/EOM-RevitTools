<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EOM Lab — Найти помещение" Width="1060" Height="640"
        MinWidth="790" MinHeight="495" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        __VM_STYLE__
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="9,7"/>
      </Style>
      <Style TargetType="ListViewItem">
        <Setter Property="Padding" Value="5,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <Border x:Name="row_surface" Background="Transparent"
                      BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                      Padding="{TemplateBinding Padding}">
                <GridViewRowPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                      Columns="{TemplateBinding GridView.ColumnCollection}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="row_surface" Property="Background" Value="{StaticResource WindowBg}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="row_surface" Property="Background" Value="{StaticResource AccentSoft}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,8">
      <DockPanel>
        <Button x:Name="gear" DockPanel.Dock="Right" Style="{StaticResource Icon}"
                Width="34" Height="30" FontSize="15" Content="&#xE713;"
                ToolTip="Настроить параметры поиска"
                AutomationProperties.Name="Настроить параметры поиска"/>
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Найти помещение"/>
          <TextBlock x:Name="context" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="settings" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Card}"
            Margin="0,0,0,8" BorderBrush="{StaticResource Accent}" Padding="12,9">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="Параметры поиска" Margin="0,0,0,7"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Параметр 1" Margin="0,0,0,3"/>
            <ComboBox x:Name="first" MinHeight="27" MaxDropDownHeight="300"
                      AutomationProperties.Name="Параметр 1"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Параметр 2" Margin="0,0,0,3"/>
            <ComboBox x:Name="second" MinHeight="27" MaxDropDownHeight="300"
                      AutomationProperties.Name="Параметр 2"/>
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button x:Name="cancel_settings" Content="Отмена" Margin="0,0,6,0"/>
          <Button x:Name="save" Content="Сохранить" Style="{StaticResource Primary}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Style="{StaticResource H2}" Text="Поиск" Margin="0,0,0,4"/>
          <TextBox x:Name="query" MinHeight="28" AutomationProperties.Name="Искомое значение"/>
          <TextBlock x:Name="field_hint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource H2}" Text="Модель" Margin="0,0,0,4"/>
          <ComboBox x:Name="source" MinHeight="28" MaxDropDownHeight="300"
                    AutomationProperties.Name="Модель"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
      <ListView x:Name="results" BorderThickness="0" Background="Transparent"
                SelectionMode="Single" AutomationProperties.Name="Найденные помещения"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Header="Помещение" Width="245" DisplayMemberBinding="{Binding Room}"/>
            <GridViewColumn Header="Значения параметров" Width="230" DisplayMemberBinding="{Binding Values}"/>
            <GridViewColumn Header="Уровень" Width="158" DisplayMemberBinding="{Binding Level}"/>
            <GridViewColumn Header="Модель" Width="340" DisplayMemberBinding="{Binding Source}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
            Margin="0,10,0,0" Padding="0,8,0,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Закрыть" IsCancel="True" Margin="0,0,6,0"/>
          <Button x:Name="show_result" Content="Показать на виде" Style="{StaticResource Primary}"
                  IsEnabled="False"/>
        </StackPanel>
        <TextBlock x:Name="status" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
