<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMNX_Фильтр" Width="430" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FAFBFC" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#F4F6F8"/>
      <Setter Property="BorderBrush" Value="#C3CBD3"/>
      <Setter Property="Foreground" Value="#263238"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="20,18,20,18">
    <TextBlock Text="Заполнить параметр у элементов модели" FontSize="15" FontWeight="SemiBold"
               Foreground="#263238"/>
    <TextBlock Text="Записывается во все элементы, у которых есть параметр SMNX_Фильтр."
               Foreground="#78909C" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,16"/>

    <TextBlock Text="Значение" Foreground="#455A64" Margin="0,0,0,4"/>
    <TextBox x:Name="value_box" Padding="6,5" FontSize="14"/>

    <TextBlock Text="Если параметр уже заполнен" Foreground="#455A64" Margin="0,16,0,6"/>
    <RadioButton x:Name="only_empty_radio" GroupName="mode" IsChecked="True" Margin="0,0,0,6">
      <TextBlock Text="Не трогать — заполнить только пустые"/>
    </RadioButton>
    <RadioButton x:Name="overwrite_radio" GroupName="mode">
      <TextBlock Text="Перезаписать новым значением"/>
    </RadioButton>

    <Border Background="#EEF2F5" CornerRadius="6" Padding="12,10" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock x:Name="todo_label" FontSize="15" FontWeight="SemiBold" Foreground="#1B5E20"/>
        <TextBlock x:Name="details_label" Foreground="#546E7A" FontSize="12" Margin="0,4,0,0"
                   TextWrapping="Wrap" LineHeight="17"/>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="cancel_button" Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="ok_button" Content="Записать" IsDefault="True"
              Background="#1E6FD9" BorderBrush="#1A5FBC" Foreground="White"/>
    </StackPanel>
  </StackPanel>
</Window>
